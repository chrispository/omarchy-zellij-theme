#!/bin/bash

THEME_NAME="$1"
COLORS_FILE="$2"

if [[ -z "$THEME_NAME" ]] || [[ ! -f "$COLORS_FILE" ]]; then
  exit 0
fi

hex_to_rgb() {
  local hex="${1#\#}"
  printf "%d;%d;%d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

ACCENT=$(grep '^accent' "$COLORS_FILE" | cut -d'"' -f2)
COLOR1=$(grep '^color1 ' "$COLORS_FILE" | cut -d'"' -f2)
COLOR2=$(grep '^color2 ' "$COLORS_FILE" | cut -d'"' -f2)
COLOR3=$(grep '^color3 ' "$COLORS_FILE" | cut -d'"' -f2)
COLOR4=$(grep '^color4 ' "$COLORS_FILE" | cut -d'"' -f2)
COLOR5=$(grep '^color5 ' "$COLORS_FILE" | cut -d'"' -f2)
COLOR6=$(grep '^color6 ' "$COLORS_FILE" | cut -d'"' -f2)

A=$(hex_to_rgb "$ACCENT")
COLORS=(
  "$(hex_to_rgb "$COLOR1")"
  "$(hex_to_rgb "$COLOR2")"
  "$(hex_to_rgb "$COLOR3")"
  "$(hex_to_rgb "$COLOR4")"
  "$(hex_to_rgb "$COLOR5")"
  "$(hex_to_rgb "$COLOR6")"
)

TERM_COLS=$(tput cols)
TERM_LINES=$(tput lines)
START_ROW=$(( (TERM_LINES - 3) / 2 ))

move_to() {
  printf '\033[%d;%dH' "$1" "$2"
}

clear
printf '\033[?25l'

LABEL="◆ $THEME_NAME"
LABEL_LEN=$(( ${#THEME_NAME} + 2 ))
LABEL_COL=$(( (TERM_COLS - LABEL_LEN) / 2 ))

move_to "$START_ROW" "$LABEL_COL"
printf '\033[1;38;2;%sm%s\033[0m' "$A" "$LABEL"

COLORS_WIDTH=$(( ${#COLORS[@]} * 4 ))
COLORS_COL=$(( (TERM_COLS - COLORS_WIDTH) / 2 ))

move_to $((START_ROW + 2)) "$COLORS_COL"
for c in "${COLORS[@]}"; do
  printf '\033[48;2;%sm    \033[0m' "$c"
  sleep 0.03
done

sleep 0.75
printf '\033[?25h'
