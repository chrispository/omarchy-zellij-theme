#!/usr/bin/env bash

set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
COLORS_FILE="$HOME/.config/omarchy/current/theme/colors.toml"
ZELLIJ_CONFIG="$HOME/.config/zellij/config.kdl"
TEMPLATE_FILE="$SCRIPT_DIR/zellij.kdl.tpl"
START_MARKER="// --- omarchy-zellij-theme (start) ---"
END_MARKER="// --- omarchy-zellij-theme (end) ---"

rendered_theme=''
sed_script=''
rendered_zellij=''
rendered_theme_node=''
clean_config=''
config_tmp=''

cleanup() {
    [[ -z "$rendered_theme" ]] || rm -f -- "$rendered_theme"
    [[ -z "$sed_script" ]] || rm -f -- "$sed_script"
    [[ -z "$rendered_zellij" ]] || rm -f -- "$rendered_zellij"
    [[ -z "$rendered_theme_node" ]] || rm -f -- "$rendered_theme_node"
    [[ -z "$clean_config" ]] || rm -f -- "$clean_config"
    [[ -z "$config_tmp" ]] || rm -f -- "$config_tmp"
}
trap cleanup EXIT

hex_to_rgb() {
    local hex="${1#\#}"
    printf '%d,%d,%d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

trim_trailing_blank_lines() {
    local input_file="$1"
    local output_file="$2"

    awk '
        {
            lines[NR] = $0
            if ($0 !~ /^[[:space:]]*$/) {
                last = NR
            }
        }
        END {
            for (line = 1; line <= last; line++) {
                print lines[line]
            }
        }
    ' "$input_file" > "$output_file"
}

render_template() {
    local colors_file="$1"
    local template_file="$2"
    local output_file="$3"
    local key value rgb

    sed_script="$(mktemp)"

    while IFS='=' read -r key value; do
        key="${key// /}"
        key="${key//$'\t'/}"
        key="${key//\"/}"
        key="${key//\'/}"
        [[ -n "$key" && "$key" != \#* ]] || continue

        value="${value// /}"
        value="${value//$'\t'/}"
        value="${value//\"/}"
        value="${value//\'/}"
        value="${value//$'\r'/}"

        printf 's|{{ %s }}|%s|g\n' "$key" "$value" >> "$sed_script"
        printf 's|{{ %s_strip }}|%s|g\n' "$key" "${value#\#}" >> "$sed_script"

        if [[ "$value" =~ ^#[[:xdigit:]]{6}$ ]]; then
            rgb="$(hex_to_rgb "$value")"
            printf 's|{{ %s_rgb }}|%s|g\n' "$key" "$rgb" >> "$sed_script"
        fi
    done < "$colors_file"

    sed -f "$sed_script" "$template_file" > "$output_file"
    rm -f -- "$sed_script"
    sed_script=''
}

if [[ ! -f "$COLORS_FILE" || ! -f "$ZELLIJ_CONFIG" || ! -f "$TEMPLATE_FILE" ]]; then
    exit 0
fi

rendered_theme="$(mktemp)"
rendered_zellij="$(mktemp)"
render_template "$COLORS_FILE" "$TEMPLATE_FILE" "$rendered_theme"

# Zellij KDL expects RGB values separated by spaces, while Omarchy templates
# expose RGB values as comma-separated strings.
sed 's/\([0-9]\{1,3\}\),\([0-9]\{1,3\}\),\([0-9]\{1,3\}\)/\1 \2 \3/g' \
    "$rendered_theme" > "$rendered_zellij"

if ! grep -qE '^themes[[:space:]]*\{' "$rendered_zellij" || ! grep -qE '^    omarchy[[:space:]]*\{' "$rendered_zellij"; then
    printf '%s\n' 'omarchy-zellij-theme: rendered theme block is invalid' >&2
    exit 1
fi

rendered_theme_node="$(mktemp)"
sed '1d;$d' "$rendered_zellij" > "$rendered_theme_node"

config_tmp="$(mktemp "$(dirname "$ZELLIJ_CONFIG")/.config.kdl.XXXXXX")"
clean_config="$(mktemp)"
sed "\%$START_MARKER%,\%$END_MARKER%d" "$ZELLIJ_CONFIG" > "$clean_config"

themes_end_line="$(awk '
    !found && $0 ~ /^[[:space:]]*themes[[:space:]]*\{/ {
        found = 1
        depth = 1
        next
    }
    found {
        depth += gsub(/\{/, "{")
        depth -= gsub(/\}/, "}")
        if (depth == 0) {
            print NR
            exit
        }
    }
' "$clean_config")"

if [[ -n "$themes_end_line" ]]; then
    head -n "$((themes_end_line - 1))" "$clean_config" |
        trim_trailing_blank_lines /dev/stdin "$config_tmp"
    printf '\n%s\n' "$START_MARKER" >> "$config_tmp"
    cat "$rendered_theme_node" >> "$config_tmp"
    printf '%s\n' "$END_MARKER" >> "$config_tmp"
    tail -n +"$themes_end_line" "$clean_config" >> "$config_tmp"
else
    trim_trailing_blank_lines "$clean_config" "$config_tmp"
    printf '\n%s\n' "$START_MARKER" >> "$config_tmp"
    cat "$rendered_zellij" >> "$config_tmp"
    printf '%s\n' "$END_MARKER" >> "$config_tmp"
fi

rm -f -- "$clean_config"

if cmp -s "$config_tmp" "$ZELLIJ_CONFIG"; then
    exit 0
fi

chmod --reference="$ZELLIJ_CONFIG" "$config_tmp"
mv -- "$config_tmp" "$ZELLIJ_CONFIG"
config_tmp=''

if [[ "${OMARCHY_ZELLIJ_THEME_NOTIFY:-1}" != 1 ]] || ! command -v zellij >/dev/null 2>&1; then
    exit 0
fi

THEME_NAME="${1:-$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || true)}"
COLORS_FILE="$HOME/.config/omarchy/current/theme/colors.toml"
NOTIFY_SCRIPT="$SCRIPT_DIR/theme-notify"

if [[ -z "$THEME_NAME" || ! -f "$COLORS_FILE" || ! -x "$NOTIFY_SCRIPT" ]]; then
    exit 0
fi

ACTIVE_SESSIONS="$(zellij list-sessions --no-formatting 2>/dev/null | awk '!/EXITED/ {print $1}')"
while IFS= read -r session; do
    [[ -n "$session" ]] || continue
    ZELLIJ_SESSION_NAME="$session" zellij action new-pane \
        --floating \
        --close-on-exit \
        --borderless true \
        --width '100%' \
        --height '100%' \
        --x '0' \
        --y '0' \
        -- "$NOTIFY_SCRIPT" "$THEME_NAME" "$COLORS_FILE" &
done <<< "$ACTIVE_SESSIONS"
